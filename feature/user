<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Banking & Personal Finance Management</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f6f9;
            color: #222;
        }

        header {
            background: #12355b;
            color: white;
            padding: 18px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 24px;
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .profile img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: white;
        }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: 30px auto;
        }

        .welcome {
            margin-bottom: 25px;
        }

        .welcome h2 {
            color: #12355b;
            margin-bottom: 5px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 22px;
            border-radius: 12px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .card h3 {
            color: #666;
            font-size: 15px;
            margin-bottom: 10px;
        }

        .card p {
            font-size: 25px;
            font-weight: bold;
            color: #12355b;
        }

        .dashboard {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 25px;
        }

        .section {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .section h2 {
            color: #12355b;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 13px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        th {
            background: #f1f4f8;
        }

        .income {
            color: green;
            font-weight: bold;
        }

        .expense {
            color: red;
            font-weight: bold;
        }

        .budget {
            margin-bottom: 20px;
        }

        .budget-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 7px;
        }

        .progress {
            height: 10px;
            background: #ddd;
            border-radius: 10px;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            background: #12355b;
        }

        .buttons {
            margin-top: 25px;
            display: flex;
            gap: 10px;
        }

        button {
            border: none;
            padding: 12px 18px;
            border-radius: 7px;
            cursor: pointer;
            background: #12355b;
            color: white;
        }

        button:hover {
            background: #0d2945;
        }

        footer {
            text-align: center;
            padding: 25px;
            margin-top: 40px;
            background: #12355b;
            color: white;
        }

        @media (max-width: 900px) {
            .cards {
                grid-template-columns: repeat(2, 1fr);
            }

            .dashboard {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {
            .cards {
                grid-template-columns: 1fr;
            }

            header {
                padding: 15px;
            }

            .container {
                width: 95%;
            }

            table {
                font-size: 13px;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>MyBank Finance</h1>

    <div class="profile">
        <span>Prakhar Soni</span>
        <img src="https://via.placeholder.com/40" alt="Profile">
    </div>
</header>

<div class="container">

    <div class="welcome">
        <h2>Welcome, Prakhar 👋</h2>
        <p>Manage your banking and personal finances in one place.</p>
    </div>

    <!-- Financial Summary -->
    <div class="cards">

        <div class="card">
            <h3>Total Balance</h3>
            <p>₹85,450</p>
        </div>

        <div class="card">
            <h3>Monthly Income</h3>
            <p>₹45,000</p>
        </div>

        <div class="card">
            <h3>Monthly Expenses</h3>
            <p>₹27,500</p>
        </div>

        <div class="card">
            <h3>Savings</h3>
            <p>₹17,500</p>
        </div>

    </div>

    <div class="dashboard">

        <!-- Transactions -->
        <div class="section">
            <h2>Recent Transactions</h2>

            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Amount</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>23 Sep</td>
                        <td>Salary</td>
                        <td>Income</td>
                        <td class="income">+₹45,000</td>
                    </tr>

                    <tr>
                        <td>22 Sep</td>
                        <td>Amazon Shopping</td>
                        <td>Shopping</td>
                        <td class="expense">-₹2,500</td>
                    </tr>

                    <tr>
                        <td>20 Sep</td>
                        <td>Electricity Bill</td>
                        <td>Bills</td>
                        <td class="expense">-₹1,800</td>
                    </tr>

                    <tr>
                        <td>18 Sep</td>
                        <td>Food & Restaurant</td>
                        <td>Food</td>
                        <td class="expense">-₹1,200</td>
                    </tr>
                </tbody>
            </table>

            <div class="buttons">
                <button onclick="addTransaction()">Add Transaction</button>
                <button onclick="viewTransactions()">View All</button>
            </div>
        </div>

        <!-- Budget -->
        <div class="section">
            <h2>Monthly Budget</h2>

            <div class="budget">
                <div class="budget-info">
                    <span>Food</span>
                    <span>₹4,000 / ₹6,000</span>
                </div>

                <div class="progress">
                    <div class="progress-bar" style="width: 67%;"></div>
                </div>
            </div>

            <div class="budget">
                <div class="budget-info">
                    <span>Shopping</span>
                    <span>₹7,500 / ₹10,000</span>
                </div>

                <div class="progress">
                    <div class="progress-bar" style="width: 75%;"></div>
                </div>
            </div>

            <div class="budget">
                <div class="budget-info">
                    <span>Transport</span>
                    <span>₹2,000 / ₹5,000</span>
                </div>

                <div class="progress">
                    <div class="progress-bar" style="width: 40%;"></div>
                </div>
            </div>

            <div class="budget">
                <div class="budget-info">
                    <span>Bills</span>
                    <span>₹3,500 / ₹5,000</span>
                </div>

                <div class="progress">
                    <div class="progress-bar" style="width: 70%;"></div>
                </div>
            </div>

        </div>

    </div>

</div>

<footer>
    <p>© 2026 MyBank Finance | Secure Personal Finance Management</p>
</footer>

<script>

    function addTransaction() {
        alert("Add Transaction feature will be implemented here.");
    }

    function viewTransactions() {
        alert("Opening all transactions...");
    }

</script>

</body>
</html>
```
